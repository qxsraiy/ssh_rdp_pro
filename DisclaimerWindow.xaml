<Window x:Class="云端管理.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="免责声明" Height="430" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Effect>
        <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.15" Color="Black"/>
    </Window.Effect>

    <Border CornerRadius="16" Background="#F5F6F8" BorderBrush="White" BorderThickness="1.5" Margin="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="16,16,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="⚠️ 免责声明" Foreground="White" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="22,16,22,10">
                <StackPanel>
                    <TextBlock Text="使用本软件即表示您已阅读并同意以下条款：" Foreground="#222" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="1. 本软件为 SSH / RDP 连接管理工具，所有服务器凭据（账号、密码、私钥）仅保存在您本机，并使用您设置的主密码进行 AES-256 加密。主密码仅存于您的记忆与客户端内存中，任何情况下都不会上传至服务器。" Foreground="#444" FontSize="12.5" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>

                    <TextBlock Text="2. 若您遗忘主密码，已保存的凭据将无法解密恢复，请务必妥善保管主密码。" Foreground="#444" FontSize="12.5" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>

                    <TextBlock Text="3. 云同步功能（官方云 / WebDAV）仅用于备份与多设备同步加密后的数据。服务器端仅存储密文，但您仍需自行评估云服务商的可信度。" Foreground="#444" FontSize="12.5" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>

                    <TextBlock Text="4. 本软件不承担因使用本软件导致的任何直接或间接损失，包括但不限于：服务器配置错误、凭据泄露、数据丢失、业务中断等。" Foreground="#444" FontSize="12.5" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>

                    <TextBlock Text="5. 请确保您对通过本软件连接的所有服务器拥有合法管理权限，遵守相关法律法规与所在组织的安全策略。" Foreground="#444" FontSize="12.5" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,6"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="BtnDecline" Content="拒 绝" Width="100" Height="38" Margin="0,0,12,0"
                        Background="#E0E0E0" Foreground="#555" FontSize="13" BorderThickness="0"
                        Click="Decline_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#D0D0D0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnAgree" Content="同意并继续" Width="130" Height="38"
                        Background="#1A1A1A" Foreground="White" FontSize="13" BorderThickness="0"
                        Click="Agree_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>