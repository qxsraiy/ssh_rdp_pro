<Window x:Class="云端管理.EditServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器配置" Height="640" Width="470" 
        WindowStartupLocation="CenterOwner" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A6172"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 分段选择按钮 -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" CornerRadius="7" Margin="3" Background="Transparent" Cursor="Hand">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A91A3" FontWeight="Bold" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="txt" Property="Foreground" Value="#1A73E8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground" Value="#1A73E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#1A73E8" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0D5BD0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#EDEFF4" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E0E4EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.2" Color="Black"/>
    </Window.Effect>

    <Border CornerRadius="16" Background="#F5F6FA" BorderBrush="White" BorderThickness="1.5" Margin="10">
        <Grid Margin="28,18,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="WindowTitle" Text="新增服务器" FontSize="19" FontWeight="Bold" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Width="32" Height="32" Foreground="#9AA0AE" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" ToolTip="关闭">
                    <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Margin="0" Padding="0"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel>
                    <!-- 协议类型 -->
                    <TextBlock Text="连接协议"/>
                    <Border CornerRadius="11" Background="#E9EBF2" Height="44" Margin="0,0,0,18">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="RadioSSH" Content="🔌 SSH 远程终端" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="Protocol_Changed"/>
                            <RadioButton x:Name="RadioRDP" Content="🖥️ RDP 远程桌面" Style="{StaticResource SegmentButton}" Checked="Protocol_Changed"/>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="服务器名称 (别名)"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="NameInput"/>
                    </Border>

                    <TextBlock Text="主机 IP 地址  *"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="HostInput"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="端口"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="PortInput" Text="22"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="用户名"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="UserInput"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- SSH 认证方式（RDP 时自动隐藏） -->
                    <StackPanel x:Name="AuthArea">
                        <TextBlock Text="认证方式"/>
                        <Border CornerRadius="11" Background="#E9EBF2" Height="44" Margin="0,0,0,18">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="RadioPwd" Content="🔑 密码登录" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="AuthType_Changed"/>
                                <RadioButton x:Name="RadioKey" Content="📄 私钥登录" Style="{StaticResource SegmentButton}" Checked="AuthType_Changed"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="SecretLabel" Text="SSH 密码"/>
                    <Grid x:Name="PasswordArea">
                        <Border Style="{StaticResource InputBorder}">
                            <PasswordBox x:Name="PasswordInput"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="KeyArea" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource InputBorder}" Grid.Column="0" Margin="0,0,10,16">
                            <TextBox x:Name="KeyPathDisplay" IsReadOnly="True" Text="未选择密钥文件" Foreground="#9AA0AE"/>
                        </Border>
                        <Button Grid.Column="1" Content="选择文件" Margin="0,0,0,16" Width="90" Style="{StaticResource SecondaryBtn}" Click="SelectKey_Click"/>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button Content="取 消" Margin="0,0,8,0" Style="{StaticResource SecondaryBtn}" Foreground="#5A6172" Click="Cancel_Click"/>
                        <Button x:Name="SaveBtn" Content="保 存" Margin="8,0,0,0" Style="{StaticResource PrimaryBtn}" Foreground="White" Click="Save_Click"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>