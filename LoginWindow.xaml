<Window x:Class="云端管理.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安全解锁" Height="548" Width="440" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="17.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="#333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模式选择按钮样式 -->
        <Style x:Key="ModeBtn" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" CornerRadius="6" Margin="3" Background="Transparent" Cursor="Hand">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" FontWeight="Bold" Margin="0" FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="txt" Property="Foreground" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框外壳样式 -->
        <Style x:Key="InputShell" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#88FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect BlurRadius="5" ShadowDepth="3" Opacity="0.15" Color="Black"/>
    </Window.Effect>

    <Border CornerRadius="20" Background="#E6FFFFFF" BorderBrush="White" BorderThickness="1.5" Margin="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="SSH Manager" Foreground="#333" FontSize="12" FontWeight="Bold" Opacity="0.6"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Content="✕" Click="Close_Click" Style="{StaticResource IconBtnStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="32,0,32,18">
                <!-- 登录方式选择 -->
                <TextBlock Text="登录方式" Foreground="#666" FontSize="12" Margin="0,0,0,6"/>
                <Border CornerRadius="8" Background="#E0E0E0" Height="38" Margin="0,0,0,12">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="ModeOfficial" Content="官方同步" Style="{StaticResource ModeBtn}" GroupName="SyncMode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeWebDAV" Content="WebDAV同步" Style="{StaticResource ModeBtn}" GroupName="SyncMode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeLocal" Content="本地使用" Style="{StaticResource ModeBtn}" GroupName="SyncMode" Checked="Mode_Changed"/>
                    </UniformGrid>
                </Border>

                <!-- ========== 官方同步面板 ========== -->
                <StackPanel x:Name="OfficialPanel" Visibility="Collapsed">
                    <TextBlock Text="云端账号 (账号不存在将自动注册)" Foreground="#666" FontSize="12"/>
                    <Border Style="{StaticResource InputShell}" Margin="0,3,0,8">
                        <TextBox x:Name="AccountInput" Padding="10,7" FontSize="14" Background="Transparent" Foreground="#111" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="主密码 (仅本地加解密，绝不上传)" Foreground="#666" FontSize="12"/>
                    <Border Style="{StaticResource InputShell}" Margin="0,3,0,6">
                        <PasswordBox x:Name="MasterPwdInputOfficial" Padding="10,7" FontSize="14" Background="Transparent" Foreground="#111" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="PasswordInput_KeyDown"/>
                    </Border>

                    <TextBlock Text="提示: 云端只按账号存取密文，不校验密码。数据由主密码加密，别人拿到账号也解不开。" 
                               Foreground="#999" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ========== WebDAV 同步面板（配置直接内嵌） ========== -->
                <StackPanel x:Name="WebDAVPanel" Visibility="Collapsed">
                    <TextBlock Text="WebDAV 服务器地址 (如: https://dav.jianguoyun.com/dav/)" Foreground="#666" FontSize="12"/>
                    <Border Style="{StaticResource InputShell}" Margin="0,3,0,8">
                        <TextBox x:Name="WebDavUrlInput" Padding="10,7" FontSize="13" Background="Transparent" Foreground="#111" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="WebDAV 账号" Foreground="#666" FontSize="12"/>
                    <Border Style="{StaticResource InputShell}" Margin="0,3,0,8">
                        <TextBox x:Name="WebDavUserInput" Padding="10,7" FontSize="14" Background="Transparent" Foreground="#111" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="WebDAV 应用授权码/密码" Foreground="#666" FontSize="12"/>
                    <Border Style="{StaticResource InputShell}" Margin="0,3,0,8">
                        <PasswordBox x:Name="WebDavPwdInput" Padding="10,7" FontSize="14" Background="Transparent" Foreground="#111" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="PasswordInput_KeyDown"/>
                    </Border>

                    <TextBlock Text="主密码 (仅本地加解密，绝不上传)" Foreground="#666" FontSize="12"/>
                    <Border Style="{StaticResource InputShell}" Margin="0,3,0,6">
                        <PasswordBox x:Name="MasterPwdInputWebDAV" Padding="10,7" FontSize="14" Background="Transparent" Foreground="#111" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="PasswordInput_KeyDown"/>
                    </Border>
                </StackPanel>

                <!-- ========== 本地使用面板 ========== -->
                <StackPanel x:Name="LocalPanel">
                    <TextBlock Text="主密码 (仅本地加解密，绝不上传)" Foreground="#666" FontSize="12"/>
                    <Border Style="{StaticResource InputShell}" Margin="0,3,0,10">
                        <PasswordBox x:Name="MasterPwdInputLocal" Padding="10,7" FontSize="18" Background="Transparent" Foreground="#111" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="PasswordInput_KeyDown"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="StatusLabel" Text="请选择登录方式并输入主密码:" Foreground="#444" FontSize="12.5" Margin="0,4,0,8" HorizontalAlignment="Center"/>

                <Button x:Name="LoginBtn" Content="解 锁" Height="40" FontSize="15" FontWeight="Bold" Foreground="White" 
                        Click="Login_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="#1A1A1A" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#888"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock HorizontalAlignment="Center" Margin="0,9,0,0" FontSize="11" Foreground="#888">
                    <Run Text="首次使用请阅读"/>
                    <Hyperlink x:Name="DisclaimerLink" Click="Disclaimer_Click" Foreground="#1A1A1A">免责条款</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>