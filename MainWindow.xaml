<Window x:Class="云端管理.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Manager Pro" Height="660" Width="960" 
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 侧边栏图标按钮（浅色高对比） -->
        <Style x:Key="SideButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Background" Value="#F0F2F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#E2E6EF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#DCE7FB"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#1A73E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C3D7F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 系统按钮（浅色高对比） -->
        <Style x:Key="SysBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Background" Value="#F0F2F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#4A5162"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#E2E6EF" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E4E8F0"/>
                                <Setter Property="Foreground" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮（浅红 → 悬停深红） -->
        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Background" Value="#FDE9E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#F3C9C9"/>
            <Setter Property="Foreground" Value="#D64545"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#D93036"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#D93036"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#B3272C"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#B3272C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表卡片项 -->
        <Style x:Key="ServerCardStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="White" CornerRadius="12" Margin="0,0,0,10" Padding="16,12" BorderBrush="#ECEEF3" BorderThickness="1"
                                Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#1A73E8"/>
                                <Setter TargetName="Card" Property="Background" Value="#F8FAFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#1A73E8"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="Card" Property="Background" Value="#EEF4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.2" Color="Black"/>
    </Window.Effect>

    <Border CornerRadius="16" Background="#F5F6FA" BorderBrush="White" BorderThickness="1.5" Margin="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧浅色导航栏（高对比） ===== -->
            <Border Background="#FFFFFF" CornerRadius="16,0,0,16" BorderBrush="#E4E7EE" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A73E8">
                            <TextBlock Text="🖧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,18,0,0" HorizontalAlignment="Center">
                        <Button Content="➕" Click="Add_Click" Style="{StaticResource SideButtonStyle}" ToolTip="新增设备"/>
                        <Button Content="✏️" Click="Edit_Click" Style="{StaticResource SideButtonStyle}" ToolTip="修改配置"/>
                        <Button Content="🗑️" Click="Delete_Click" Style="{StaticResource SideButtonStyle}" ToolTip="删除设备"/>
                    </StackPanel>

                    <!-- 系统按钮 -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
                        <TextBlock Text="SSH Pro" FontSize="10" Foreground="#9AA0AE" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Button Content="—" Click="Minimize_Click" Style="{StaticResource SysBtnStyle}" ToolTip="最小化"/>
                        <Button Content="✕" Click="Close_Click" Style="{StaticResource CloseBtnStyle}" ToolTip="退出"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 右侧内容区 ===== -->
            <Grid Grid.Column="1" Margin="28,0,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0">
                    <TextBlock Text="设备工作台" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                    <TextBlock Text="双击设备卡片或选中后点击连接" FontSize="11" Foreground="#9AA0AE" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </Grid>

                <!-- 搜索框 -->
                <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E4E7EE" BorderThickness="1" Height="36" VerticalAlignment="Top">
                    <Grid Margin="12,0">
                        <TextBlock Text="🔍  搜索名称 / IP / 用户名..." FontSize="12" Foreground="#B0B5C2" VerticalAlignment="Center"
                                   x:Name="SearchPlaceholder" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="12.5" VerticalContentAlignment="Center"
                                 Foreground="#1A1A1A" TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- 设备列表 -->
                <ListBox x:Name="ServerListBox" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,12,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ServerCardStyle}"
                         MouseDoubleClick="ServerListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 协议徽章 -->
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5EE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Protocol}" Value="RDP">
                                                    <Setter Property="Background" Value="#E8EEFB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#0F9D58" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="SSH"/>
                                                <Setter Property="Foreground" Value="#0F9D58"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Protocol}" Value="RDP">
                                                        <Setter Property="Text" Value="RDP"/>
                                                        <Setter Property="Foreground" Value="#1A73E8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- 名称 / 地址 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#1A1A1A"/>
                                    <TextBlock FontSize="11.5" Foreground="#7A8194" Margin="0,3,0,0">
                                        <Run Text="{Binding Username}"/><Run Text="  @  "/><Run Text="{Binding Host}"/><Run Text=":"/><Run Text="{Binding Port}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 认证方式标签 -->
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10.5" Foreground="#9AA0AE"
                                           Text="{Binding AuthType, StringFormat={}{0}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态提示 -->
                <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="还没有设备，点击左侧 ➕ 新增" FontSize="13" Foreground="#B0B5C2"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- 连接按钮 -->
                <Button Grid.Row="3" Content="⚡ 即 刻 连 接" Click="Connect_Click" Height="46" Margin="0,10,0,0"
                        Background="#1A73E8" Foreground="White" FontSize="15" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btn" Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btn" Property="Background" Value="#0D5BD0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btn" Property="Background" Value="#A8C7F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 同步状态栏 -->
                <TextBlock x:Name="SyncStatus" Grid.Row="4" Text="" FontSize="10.5" Foreground="#9AA0AE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 右下角调节大小手柄 -->
            <Path VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,10"
                  Stroke="#9AA0AE" StrokeThickness="1.5" IsHitTestVisible="False"
                  Data="M 0,10 L 10,0 M 0,5 L 5,0"/>
        </Grid>
    </Border>
</Window>